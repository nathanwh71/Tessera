<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ETL pipeline that turns a file of places into a seed script for DbUp (ADR 0009, US-24).
       A tool beside the service, not part of it: the service never runs it. -->
  <PropertyGroup>
    <!-- A program of its own, since npm run etl starts it with dotnet. -->
    <OutputType>Exe</OutputType>
    <!-- A tool for this repository alone, so no NuGet package is made of it. -->
    <IsPackable>false</IsPackable>
    <!-- The text filter puts names into one Unicode form, which needs the full Unicode tables;
         Directory.Build.props turns them off for the rest. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shapes, and the tests the filters make on them. -->
    <PackageReference Include="NetTopologySuite" />
    <!-- Turns GeoJSON geometry into shapes with .NET's own JSON reader. -->
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" />
    <!-- Result, a value that holds either an answer or the faults, so a function returns its
         faults rather than throwing them (ADR 0004). -->
    <PackageReference Include="CSharpFunctionalExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the tests read internal members, such as PipelineFile.Options, without making them
         public; no test reads one yet. -->
    <InternalsVisibleTo Include="Tessera.Etl.Tests" />
  </ItemGroup>
</Project>
