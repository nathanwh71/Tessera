# Copy this file to .env and give each password a value of its own. Git ignores .env, so no
# password reaches the repository (US-00 c4). npm start and npm run publish read it.

# The database owner's password, for the start-up script alone.
TESSERA_DB_PASSWORD=

# The service's role, tessera_reader, and the publisher's role, tessera_publisher (ADR 0001).
TESSERA_READER_PASSWORD=
TESSERA_PUBLISHER_PASSWORD=

# The port the service answers on: 80 in the office (US-35). It overrides HttpPort in
# tessera.json, as pg_tileserv's TS_HTTPPORT does; any other key may be overridden the same way,
# such as TESSERA_CACHETTL=120.
TESSERA_HTTPPORT=80

# Optional: where the service finds the database, and the database's name. The container answers
# on this machine alone, so the defaults fit it.
# TESSERA_DB_HOST=127.0.0.1
# TESSERA_DB_PORT=5432
# TESSERA_DB_NAME=tessera
