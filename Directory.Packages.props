<Project>
  <!-- One version of each package for the whole solution, so no two projects disagree. -->
  <ItemGroup Label="Service">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <!-- Stops the build when a switch over a closed set of records misses a case. -->
    <PackageVersion Include="ExhaustiveMatching.Analyzer" Version="0.5.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.299" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="NetTopologySuite.IO.VectorTiles.Mapbox" Version="1.1.0" />
    <!--
      Counts the lines and branches of the service each test suite runs, for the coverage floors
      that npm test and the GitHub build check (scripts/lib/coverage.ts).
    -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <!-- Reads the built program and checks the borders between its layers (ADR 0010). -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
  </ItemGroup>
</Project>
