<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The program: it puts the seven modules together and runs them as one service (ADR 0001). -->
  <PropertyGroup>
    <AssemblyName>Tessera.Service</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tessera.Kernel/Tessera.Kernel.csproj" />
    <ProjectReference Include="../Tessera.Settings/Tessera.Settings.csproj" />
    <ProjectReference Include="../Tessera.Sql/Tessera.Sql.csproj" />
    <ProjectReference Include="../Tessera.Catalogue/Tessera.Catalogue.csproj" />
    <ProjectReference Include="../Tessera.Import/Tessera.Import.csproj" />
    <ProjectReference Include="../Tessera.Tiles/Tessera.Tiles.csproj" />
    <ProjectReference Include="../Tessera.Http/Tessera.Http.csproj" />
    <ProjectReference Include="../Tessera.Map/Tessera.Map.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- tessera.json sits beside the program, where the service looks for it (ADR 0003). -->
    <None Include="../../tessera.json" Link="tessera.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The seed ships with the release, ready for the import (US-01 c2). -->
    <None Include="../../data/macau-pois.geojson" Link="data/macau-pois.geojson" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
