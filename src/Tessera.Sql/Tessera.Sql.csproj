<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The one gate to the database (S-01, ADR 0001 rule 3). Marking "compile" as private stops Npgsql and
    Dapper flowing on to the compiler of a project that references this one, so no other project can
    even name them. Their runtime files still flow, so the finished service can run them.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="Dapper" PrivateAssets="compile;contentfiles;analyzers;build" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tessera.Kernel/Tessera.Kernel.csproj" />
  </ItemGroup>
  <!-- The unit tests may call Query.Of, so they can prove that a value never enters the SQL text (S-01 test 1). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tessera.UnitTests" />
  </ItemGroup>
</Project>
