<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sql: every SQL text, and the module through which the service reaches the database (S-01, ADR 0001 rule 4).
    PrivateAssets keeps Npgsql and Dapper from the compiler of any project that names Sql, while
    their files still reach the finished service. "all" would keep the files out too, and the
    service would fail as it starts.
    The shared framework gives configuration and options, through which the database's URL is read.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="Dapper" PrivateAssets="compile;contentfiles;analyzers;build" />
    <PackageReference Include="CSharpFunctionalExtensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Settings/Tessera.Settings.csproj" />
  </ItemGroup>
</Project>
