<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The program: Program.cs and Service.cs, which put the modules together (ADR 0001). Each module
    is a project of its own, in a folder here, so this project compiles none of their files and
    names each one below.
  -->
  <PropertyGroup>
    <!-- The map's files go out as Vite built them; the SDK's static-web-assets pipeline stays off. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);Catalogue/**;Map/**;Problems/**;Seeding/**;Settings/**;Sql/**;Tiles/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Catalogue/Tessera.Catalogue.csproj" />
    <ProjectReference Include="Map/Tessera.Map.csproj" />
    <ProjectReference Include="Problems/Tessera.Problems.csproj" />
    <ProjectReference Include="Seeding/Tessera.Seeding.csproj" />
    <ProjectReference Include="Settings/Tessera.Settings.csproj" />
    <ProjectReference Include="Sql/Tessera.Sql.csproj" />
    <ProjectReference Include="Tiles/Tessera.Tiles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- tessera.json sits beside the program, where the service looks for it (ADR 0003). -->
    <None Include="../../tessera.json" Link="tessera.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The built map ships inside the release (US-23 c4). `npm run build` makes web/dist first. -->
    <Content Include="../../web/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The seed scripts ship with the release, ready for 'Tessera seed' (US-01 c2, ADR 0009). -->
    <None Include="../../db/seed/*.sql" Link="seed/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
