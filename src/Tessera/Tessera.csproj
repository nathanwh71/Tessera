<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The whole service in one project, laid out as the modular-monolith template (ADR 0010):
      Common/            what every module may use: the problem answers and the settings
      Modules/Tessera/   the one module, in three layers: Domain, Infrastructure and Features
      Program.cs         serve, or seed
    The architecture tests in tests/Tessera.ArchitectureTests guard the borders between the layers.
  -->
  <PropertyGroup>
    <!-- The program keeps its name, so 'Tessera seed', the runbook and the start-up task still work. -->
    <AssemblyName>Tessera</AssemblyName>
    <!--
      No root namespace, so each folder's path is its namespace, such as Modules.Tessera.Domain, and
      rule IDE0130 can check that every file's namespace matches its folder. The boundary rules trust
      the namespaces, so a file that claimed another layer's would slip past them.
    -->
    <RootNamespace></RootNamespace>
    <!-- The map's files go out as Vite built them; the SDK's static-web-assets pipeline stays off. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- The database client, and the library that fills records from its rows (S-01). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
    <!-- Runs each seed script once (ADR 0009). -->
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="CSharpFunctionalExtensions" />
    <!-- Checks that each switch over a union, such as DatabaseError, handles every case, as F#'s
         match does; C# 14 cannot. C# 15's closed records will do the same, and then it can go. -->
    <PackageReference Include="ExhaustiveMatching.Analyzer" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests may read internal members, such as MapRoutes.Answer, without making them public. -->
    <InternalsVisibleTo Include="Tessera.UnitTests" />
    <InternalsVisibleTo Include="Tessera.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- tessera.json sits beside the program, where the service looks for it (ADR 0003). -->
    <None Include="../../tessera.json" Link="tessera.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The built map ships inside the release (US-23 c4). `npm run build` makes web/dist first. -->
    <Content Include="../../web/dist/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The seed scripts ship with the release, ready for 'Tessera seed' (US-01 c2, ADR 0009). -->
    <None Include="../../db/seed/*.sql" Link="seed/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
