<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of pure functions: no database, no network, no clock (ADR 0004). They run in seconds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tessera.Kernel/Tessera.Kernel.csproj" />
    <ProjectReference Include="../../src/Tessera.Settings/Tessera.Settings.csproj" />
    <ProjectReference Include="../../src/Tessera.Sql/Tessera.Sql.csproj" />
    <ProjectReference Include="../../src/Tessera.Catalogue/Tessera.Catalogue.csproj" />
    <ProjectReference Include="../../src/Tessera.Import/Tessera.Import.csproj" />
    <ProjectReference Include="../../src/Tessera.Tiles/Tessera.Tiles.csproj" />
    <ProjectReference Include="../../src/Tessera.Http/Tessera.Http.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="Tessera.Kernel" />
  </ItemGroup>
  <ItemGroup>
    <!-- Approved snapshots: the text a test compares its output with (S-01 test 2). -->
    <None Include="approved/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
