<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of pure functions: no database, no network, no clock (ADR 0004). They run in seconds. -->
  <PropertyGroup>
    <!-- xunit.v3 builds each test project as a program that runs its own tests. -->
    <OutputType>Exe</OutputType>
    <!-- Tests ship to no one, so no NuGet package is made of them. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test framework every test project here uses, so all tests run the same way. -->
    <PackageReference Include="xunit.v3" />
    <!-- Property tests: FsCheck tries a hundred made-up inputs against one rule (S-01 c1, US-03). -->
    <PackageReference Include="FsCheck.Xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The service under test; its functions are called directly, with no web server between. -->
    <ProjectReference Include="../../src/Tessera/Tessera.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Names every test file uses, written once here rather than at the head of each file. -->
    <Using Include="Xunit" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="Common" />
  </ItemGroup>
  <ItemGroup>
    <!-- Approved snapshots: the text a test compares its output with (S-01 test 2). -->
    <None Include="approved/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped settings file, so a test can check it names no machine and holds no password (ADR 0003). -->
    <None Include="../../tessera.json" Link="tessera.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
