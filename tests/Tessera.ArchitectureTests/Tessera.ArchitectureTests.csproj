<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The borders between the service's layers and modules, checked on the built program (ADR 0010).
    npm test runs these first, since they take seconds and a broken border is a design fault, not a
    bug in one function.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tessera/Tessera.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
