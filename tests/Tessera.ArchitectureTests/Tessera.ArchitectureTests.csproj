<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The borders between the service's layers and modules, checked on the built program (ADR 0010).
    npm test runs these first, since they take seconds and a broken border is a design fault, not a
    bug in one function.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The program runs its tests on Microsoft.Testing.Platform even under dotnet run, so it takes
      the platform's options, such as the one that turns on coverage, and not only xUnit's own.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <!-- Lets the test program record which of the service's lines and branches this suite runs. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tessera/Tessera.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
