<Project Sdk="Microsoft.NET.Sdk">
  <!-- The border rules the compiler cannot see (ADR 0001, rules 3 and 4), checked with ArchUnitNET. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <!-- Loaded so the rules can name Npgsql's and Dapper's types; no service project may. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tessera.Service/Tessera.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
