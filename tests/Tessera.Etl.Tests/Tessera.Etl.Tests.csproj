<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the ETL pipeline (ADR 0009): pure tests of each filter and rule, and one run from a
       geodatabase that GDAL builds from the fixtures. -->
  <PropertyGroup>
    <!-- xunit.v3 builds each test project as a program that runs its own tests. -->
    <OutputType>Exe</OutputType>
    <!-- Tests ship to no one, so no NuGet package is made of them. -->
    <IsPackable>false</IsPackable>
    <!-- The tidyText tests need the full Unicode tables, as the pipeline does. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test framework the service's own tests use, so every test runs the same way. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pipeline under test; its built program also lands here, for the whole-run tests. -->
    <ProjectReference Include="../../tools/Tessera.Etl/Tessera.Etl.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Names every test file uses, written once here rather than at the head of each file. -->
    <Using Include="Xunit" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="NetTopologySuite.Geometries" />
    <Using Include="CSharpFunctionalExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Places with one fault of each kind, from which a test builds a geodatabase. -->
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
