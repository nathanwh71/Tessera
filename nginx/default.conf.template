# Nginx stands in front of the service (ADR 0008). It answers office machines alone and caps what
# each may ask (S-07, S-30, ADR 0007). It keeps each tile for as long as the service's Cache-Control
# header allows, packs answers with gzip, answers 304 when a browser's copy is still good, and
# serves the tiles it holds while the service or the database is down.
# The Nginx image fills in ${TESSERA_HTTPPORT}, ${TESSERA_OFFICE_NETWORK}, and the two copies'
# ports, ${TESSERA_SERVICE_PORT} and ${TESSERA_SECOND_SERVICE_PORT}, when it starts.

# 64 MB of tiles on disk; a tile no one asks for in ten minutes leaves, and when the store is full,
# the tile used longest ago goes first. The office's places make far fewer tiles than that, so the
# store rarely fills, yet it stays small beside the machine's disk.
# keys_zone=tiles:10m keeps the tiles' names in 10 MB of memory, room for about 80,000 of them.
# levels=1:2 spreads the files over two levels of folders, so no one folder holds thousands.
# use_temp_path=off writes each tile straight into the store's own folder, saving a copy between
# folders.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:10m max_size=64m inactive=10m use_temp_path=off;

# S-07: $office is 1 for an address inside the office's network, or for this machine itself, and 0
# for any other. A request from outside gets 403 (see the server block).
geo $office {
    default 0;
    127.0.0.1 1;
    ${TESSERA_OFFICE_NETWORK} 1;
}

# S-30: each office machine is counted by its own address. This machine's own requests, such as
# npm start's health check, have an empty key, and Nginx counts nothing for an empty key.
map $remote_addr $visitor {
    127.0.0.1 "";
    default $binary_remote_addr;
}
# 100 tiles a second for each visitor, with room for a burst of 300: one fresh view of nine layers
# asks for about a hundred tiles at once. 10 MB holds about 160,000 addresses.
limit_req_zone $visitor zone=visitor:10m rate=100r/s;
# The count of requests each visitor has open at once, by the same key, so this machine is exempt
# here too; the cap itself is in the server block.
limit_conn_zone $visitor zone=connections:10m;

# N-29: two copies of the service share the requests in turn. Passive health check: after 3 failed
# requests in 10 seconds Nginx rests a copy for 10 seconds, and sends its requests to the other.
# keepalive 16 keeps up to 16 idle connections to the copies open in each Nginx worker, so a tile
# skips the work of opening a new connection. The number caps idle connections, not traffic: past
# 16, Nginx opens new ones as before, so a small number serves one office.
# S-06 c3: '%2e' is a dot written as its number, and it has no honest use in an address here: no
# layer, page or file of the map holds one. Nginx decodes it and drops the folder before a
# '%2e%2e', so '/x/%2e%2e/food.cafes/0/0/0.pbf' would reach the tile location in disguise.
# $request_uri is the address exactly as sent, and ~* matches it in any case. $disguised is 1 for
# such an address, and the two locations that pass requests on refuse it with 400. The check
# sits in those locations, not at the server's level, since Nginx's error_page sends the 400 on
# to /malformed with the same $request_uri, where a server-level check would refuse it again.
# The service refuses a dot folder in disguise too (Common/Api/Targets.cs), for a request that
# reaches a copy directly.
map $request_uri $disguised {
    default 0;
    ~*%2e 1;
}

upstream tessera {
    server 127.0.0.1:${TESSERA_SERVICE_PORT} max_fails=3 fail_timeout=10s;
    server 127.0.0.1:${TESSERA_SECOND_SERVICE_PORT} max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen ${TESSERA_HTTPPORT};

    # S-07: a machine outside the office gets 403, before any other rule runs.
    if ($office = 0) {
        return 403;
    }
    error_page 403 = @forbidden;


    # S-30: at most 32 requests at once from one visitor. Past either limit, the answer is 429.
    limit_conn connections 32;
    limit_conn_status 429;
    limit_req_status 429;
    error_page 429 = @busy;

    # N-20: tiles and the map's files travel packed with gzip. gzip_proxied any packs answers to
    # requests that came through another proxy too, such as an office's web proxy, which Nginx
    # would otherwise send unpacked. Level 1 is the fastest: a tile shrinks nearly as much as at
    # level 9, for a fraction of the work. gzip_vary adds 'Vary: Accept-Encoding', so a cache along
    # the way never hands a packed copy to a client that cannot unpack it. gzip_types lists the
    # kinds worth packing; images are packed already.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 1;
    gzip_vary on;
    gzip_types application/vnd.mapbox-vector-tile application/problem+json application/json text/css text/javascript application/javascript;

    # The upstream is the group of service copies Nginx passes requests to, named 'tessera' above.
    # HTTP/1.1 with an empty Connection header lets its keepalive reuse connections;
    # Nginx would otherwise speak HTTP/1.0 to the copies and close each connection after one answer.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # The service sees the name the browser asked for, not the upstream's name, 'tessera'.
    proxy_set_header Host $host;
    # A copy on this same machine accepts a connection in far less than a second, so one that has
    # not done so is down, and the request moves to the other copy at once.
    proxy_connect_timeout 1s;
    # Longer than the service's own worst case, so the service answers its own 503 first, and only
    # a copy that hangs meets this limit. That worst case is the wait for a connection and the
    # query's limit together, 3 + 10 = 13 seconds (Database settings); with the database frozen
    # by 'docker pause', the service answered in 13.0 to 14.1 seconds (18 October 2026). The
    # other 6 seconds leave room for a busy machine. Raise this with either setting.
    proxy_read_timeout 20s;
    # A request that meets a copy that crashed or hangs goes to the other copy. Only a crash or a hang
    # counts against a copy; a 503 from a database outage, which both copies share, does not.
    proxy_next_upstream error timeout;

    location ~ \.(pbf|mvt)$ {
        # S-30: past the burst, a visitor's tiles answer 429 until the rate catches up.
        limit_req zone=visitor burst=300 nodelay;
        if ($disguised) {
            return 400;
        }
        proxy_pass http://tessera;
        proxy_cache tiles;
        # Many people asking for one new tile at once cost one query (N-24). The others wait as long
        # as the first request may take, 20 seconds, the same as proxy_read_timeout.
        proxy_cache_lock on;
        proxy_cache_lock_timeout 20s;
        # A tile already held is served while the service or the database cannot answer, and an
        # expired one is served while a fresh copy is fetched behind it.
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        # A browser that leaves does not cancel a tile others may be waiting for.
        proxy_ignore_client_abort on;
        # A word such as HIT, MISS or STALE on each tile, so the edge checks (scripts/lib/edge.ts)
        # and a maintainer can see whether a tile came from the store (N-19).
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Everything else, the map's page and files and /health, passes straight to the service: the
    # tile store and the rate for tiles are for tiles alone, while the cap on requests at once and
    # gzip still apply.
    location / {
        if ($disguised) {
            return 400;
        }
        proxy_pass http://tessera;
    }

    # Nginx refuses a malformed address itself, such as one that climbs above the root or holds a
    # stray '%' (S-06); the answer is a problem document that never repeats the address.
    # error_page needs an address here, not a named location such as @forbidden: Nginx meets most
    # of these faults while it still reads the request, and then a named location answers 500.
    error_page 400 /malformed;
    location = /malformed {
        # internal: only Nginx's own error_page reaches /malformed. A browser that asks for it by
        # name meets Nginx's own 404, which error_page turns into the problem document the service
        # sends for any unknown address, so /malformed looks like any other unknown address.
        internal;
        error_page 404 = @unknown;
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        return 400 '{"type":"about:blank","title":"Bad Request","status":400}';
    }

    location @unknown {
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        return 404 '{"type":"about:blank","title":"Not Found","status":404}';
    }

    # Each refusal is a problem document that names no address, as every error is (US-07).
    location @forbidden {
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        return 403 '{"type":"about:blank","title":"Forbidden","status":403}';
    }
    location @busy {
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        add_header Retry-After 1 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429}';
    }

    # With the service down and no copy held, the browser gets the service's own kind of answer:
    # a problem document that asks it to try again in five seconds (N-22, N-28).
    error_page 502 504 = @unavailable;
    location @unavailable {
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        add_header Retry-After 5 always;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503}';
    }
}
