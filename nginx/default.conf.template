# Nginx stands in front of the service (ADR 0008). It keeps each tile for as long as the service's
# Cache-Control header allows, packs answers with gzip, answers 304 when a browser's copy is still
# good, and serves the tiles it holds while the service or the database is down.
# The Nginx image fills in ${TESSERA_HTTPPORT} and ${TESSERA_SERVICE_PORT} when it starts.

# 64 MB of tiles on disk; a tile no one asks for in ten minutes goes first.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:10m max_size=64m inactive=10m use_temp_path=off;

upstream tessera {
    # Passive health check: after 3 failed requests in 10 seconds Nginx rests the server for 10
    # seconds. Nginx ignores both numbers while the group holds a single server, so they take effect
    # when a second copy of the service joins on its own line.
    server 127.0.0.1:${TESSERA_SERVICE_PORT} max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen ${TESSERA_HTTPPORT};

    gzip on;
    gzip_proxied any;
    gzip_comp_level 1;
    gzip_vary on;
    gzip_types application/vnd.mapbox-vector-tile application/problem+json application/json text/css text/javascript application/javascript;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_connect_timeout 1s;
    proxy_read_timeout 15s;
    # Only a crash or a hang counts against a server; a 503 from a database outage does not.
    proxy_next_upstream error timeout;

    location ~ \.(pbf|mvt)$ {
        proxy_pass http://tessera;
        proxy_cache tiles;
        # Many people asking for one new tile at once cost one query (N-24).
        proxy_cache_lock on;
        proxy_cache_lock_timeout 15s;
        # A tile already held is served while the service or the database cannot answer, and an
        # expired one is served while a fresh copy is fetched behind it.
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        # A browser that leaves does not cancel a tile others may be waiting for.
        proxy_ignore_client_abort on;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        proxy_pass http://tessera;
    }

    # With the service down and no copy held, the browser gets the service's own kind of answer:
    # a problem document that asks it to try again in five seconds (N-22).
    error_page 502 504 = @unavailable;
    location @unavailable {
        default_type application/problem+json;
        add_header Cache-Control no-store always;
        add_header Retry-After 5 always;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503}';
    }
}
